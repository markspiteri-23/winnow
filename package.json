{
  "name": "faucet",
  "version": "0.0.0",
  "private": true,
  "description": "Local desktop photo culler: groups near-duplicates, flags blur/exposure/blinks, writes XMP sidecars.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-builder --dir",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "test:e2e": "playwright test e2e",
    "check:security": "node scripts/check-security.mjs",
    "check:weights": "node scripts/check-weights.mjs",
    "check:eval": "tsx scripts/check-eval.ts",
    "cli": "tsx src/cli/index.ts"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "exiftool-vendored": "39.0.1",
    "sharp": "0.35.5"
  },
  "main": "out/main/index.js",
  "author": "Mark Spiteri"
}
