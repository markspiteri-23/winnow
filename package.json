{
  "name": "winnow",
  "version": "0.0.0",
  "private": true,
  "description": "Local desktop photo culler: groups near-duplicates, flags blur/exposure/blinks, writes XMP sidecars.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:security": "node scripts/check-security.mjs",
    "cli": "tsx src/cli/index.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
